{
  "name": "list-assistant",
  "version": "0.1.0",
  "description": "Obsidian plugin: guided note creation from templates, priority triage, calendar sync.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck"
  },
  "keywords": ["obsidian-plugin", "obsidian", "productivity", "eisenhower"],
  "author": "Kevin Van Slycke",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.4.11",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
